# Copy this file to .env for local development and fill in real values.
# On Render, set these under your service -> Environment instead.

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# The ENTIRE contents of your service-account JSON key file, on one
# line, wrapped in single quotes. See GOOGLE_SHEETS_SETUP.md.
GOOGLE_SERVICE_ACCOUNT_JSON=
